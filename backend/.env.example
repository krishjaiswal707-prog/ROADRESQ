# Backend Environment Configuration
PORT=5000
NODE_ENV=development

# Database Connection (Omit or leave blank to automatically use local In-Memory MongoDB)
MONGODB_URI=

# Free-First Routing & Map Providers
# OSRM (Open Source Routing Machine) - Public endpoint or custom self-hosted instance
OSRM_BASE_URL=https://router.project-osrm.org
OSRM_REQUEST_TIMEOUT_MS=6000

# TomTom Traffic API (Optional Free Tier: 2,500 daily requests)
# Register free at: https://developer.tomtom.com/
TOMTOM_API_KEY=your_tomtom_api_key_here
TOMTOM_REQUEST_TIMEOUT_MS=5000
TOMTOM_CACHE_TTL_SECONDS=60

# Traffic Monitoring Defaults
TRAFFIC_API_ENABLED=true
TRAFFIC_UPDATE_INTERVAL=60000
DEFAULT_CITY_ID=chennai

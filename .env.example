# Server Configuration
PORT=5000
NODE_ENV=production

# Database Configuration (Leave empty to use automatic in-memory MongoDB fallback)
MONGODB_URI=mongodb://localhost:27017/roadresq

# Routing & Navigation Service (Free-first OpenStreetMap OSRM)
OSRM_BASE_URL=https://router.project-osrm.org

# Real-time Traffic Simulation
DEFAULT_CITY_ID=chennai
TRAFFIC_UPDATE_INTERVAL_MS=3000

# Optional TomTom API Key for real-world traffic overlays (Fallback to simulated engine if empty)
TOMTOM_API_KEY=
